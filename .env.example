# Copy to .env (never commit the real one) and fill in when you go live.

# Port the site listens on
PORT=4173

# Secret for the RSVP admin page: /admin?key=<ADMIN_KEY>
# Leave blank and the server generates one and prints it on startup.
ADMIN_KEY=

# Outgoing email. Gmail works with an App Password (Google Account >
# Security > 2-Step Verification > App passwords). Use smtp.gmail.com / 587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=wendymarie2727@gmail.com
SMTP_PASS=your-16-character-app-password

# Shown in the From line and used as the reply-to for guest replies
MAIL_FROM="Wendy & Kayden <wendymarie2727@gmail.com>"
